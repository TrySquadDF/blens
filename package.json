{
  "name": "blens",
  "type": "module",
  "private": true,
  "workspaces": {
    "packages": [
      "packages/*"
    ],
    "catalog": {
      "typescript": "7.0.2",
      "@types/bun": "1.4.1"
    }
  },
  "devDependencies": {
    "@changesets/cli": "3.0.2"
  },
  "packageManager": "bun@1.4.2",
  "scripts": {
    "check": "bun run --cwd packages/blens check",
    "test:package": "node scripts/test-package.mjs",
    "changeset": "changeset",
    "version-packages": "changeset version && bun install --lockfile-only",
    "release": "bun run check && bun run test:package && changeset publish"
  }
}
